# Production template. Copy to .env and replace every placeholder.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DOMAIN=invoice.example.com
APP_ORIGIN=https://invoice.example.com
# BUNDLED_CADDY or EXISTING_HOST_CADDY. install.sh detects and writes this automatically.
DEPLOYMENT_MODE=BUNDLED_CADDY
DATABASE_PATH=/app/data/foreign-trade.sqlite
BUSINESS_BACKUP_LIMIT=64mb
# Generate with: openssl rand -hex 48
SESSION_SECRET=change-me
PASSWORD_MIN_LENGTH=8
# Both deployment modes fix this to one trusted Caddy proxy hop. Do not expose app publicly.
TRUST_PROXY_HOPS=1
